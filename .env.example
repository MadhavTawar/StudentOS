# StudentOS Environment Configuration Template
# Copy this file to .env and customize for your environment. Never commit real secrets.

PROJECT_NAME=StudentOS
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security & Authentication
# Generate in PowerShell: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Token Encryption Key for OAuth Credentials (Fernet 32 url-safe base64-encoded bytes)
# Generate in PowerShell: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Database Connection URL (SQLite default, PostgreSQL for production)
DATABASE_URL=sqlite:///./studentos.db
# DATABASE_URL=postgresql://user:password@localhost:5432/studentos

# Google OAuth 2.0 Credentials (Optional in local dev - mock flow enabled by default)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback

# AI configuration: "offline" or "groq"
AI_PROVIDER=offline
# Groq OpenAI-compatible chat completions endpoint and model.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-20b
# Reserved for future provider integrations; not currently consumed.
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Workspace knowledge files and vectors are stored outside frontend assets.
KNOWLEDGE_STORAGE_DIR=~/.studentos/knowledge
KNOWLEDGE_VECTOR_DIR=~/.studentos/chroma
KNOWLEDGE_MAX_UPLOAD_BYTES=15728640
KNOWLEDGE_MAX_PAGES=300
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=160
KNOWLEDGE_MAX_DISTANCE=0.65
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# CORS Allowed Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
